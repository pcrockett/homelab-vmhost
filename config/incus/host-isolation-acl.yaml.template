description: block all VM traffic to the host's bridge-facing addresses
egress:
  - description: block VM TCP to the incus bridge host address
    action: drop
    protocol: tcp
    destination: ${INCUS_V4}
    state: enabled
  - description: block VM UDP to the incus bridge host address
    action: drop
    protocol: udp
    destination: ${INCUS_V4}
    state: enabled
  - description: block VM ICMP to the incus bridge host address
    action: drop
    protocol: icmp4
    destination: ${INCUS_V4}
    state: enabled
  - description: block VM TCP to the libvirt network host address
    action: drop
    protocol: tcp
    destination: ${LIBVIRT_V4}
    state: enabled
  - description: block VM UDP to the libvirt network host address
    action: drop
    protocol: udp
    destination: ${LIBVIRT_V4}
    state: enabled
  - description: block VM ICMP to the libvirt network host address
    action: drop
    protocol: icmp4
    destination: ${LIBVIRT_V4}
    state: enabled
  - description: block VM TCP to the incus bridge host IPv6 address
    action: drop
    protocol: tcp
    destination: ${INCUS_V6}
    state: enabled
  - description: block VM UDP to the incus bridge host IPv6 address
    action: drop
    protocol: udp
    destination: ${INCUS_V6}
    state: enabled
  - description: block VM ICMP to the incus bridge host IPv6 address
    action: drop
    protocol: icmp6
    destination: ${INCUS_V6}
    state: enabled
